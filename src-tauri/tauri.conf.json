{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atena Studio",
  "version": "0.1.0",
  "identifier": "com.atena.studio",
  "build": {
    "frontendDist": "../frontend/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd frontend && pnpm run dev",
    "beforeBuildCommand": "cd frontend && pnpm run generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atena Studio - Local AI Playground & Runner",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/llama/*": "binaries/llama/",
      "../frontend/.output/public": "dist"
    },
    "externalBin": [
      "binaries/llama-server",
      "binaries/ffmpeg",
      "binaries/uv"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFOTE2RTEzREQ0REE0MEIKUldRTHBFM2RFMjZSM3JWa2t3NXZXYU9QZTRiQlRFR25kZHN2YjE5ekYzMTVUamZaM3JIRzVsdkQK",
      "endpoints": [
        "https://github.com/voylab-app/atena-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
