# ==============================================================================
# Atena Studio - Docker Environment Configuration Example
# Copy this file to .env and adjust values as needed: cp .env.example .env
# ==============================================================================

# Web Server & Host port mapping
ATENA_PORT=7860
ATENA_HOST=0.0.0.0

# Optional authentication token for web client access.
# If omitted or empty, an ephemeral token is generated on server startup.
ATENA_TOKEN=

# Static web files directory (defaults to /app/public inside container)
ATENA_STATIC_DIR=/app/public
